# =============================================================================
# PinduCcall - configuração do servidor
# Copie este arquivo para ".env" (sem o .example) e ajuste o que precisar.
# =============================================================================

# Senha da SALA PADRÃO, usada só na primeira vez que o servidor sobe: ela cria
# a sala "geral". Depois disso, cada sala criada pelo aplicativo tem senha
# própria, guardada em data/salas.json (scrypt + salt, nunca em texto puro).
# TROQUE ISTO.
ROOM_PASSWORD=troque-esta-senha

# Teto de salas cadastradas no servidor. Quem tem o aplicativo pode criar sala
# à vontade até bater neste número.
MAX_ROOMS=30

# Por quantas horas um link de convite continua abrindo a sala sem senha.
CONVITE_HORAS=24

# Depois de quantas horas SEM NINGUÉM DENTRO uma sala é apagada (com chat,
# timers e convites). A sala padrão acima nunca expira.
SALA_EXPIRA_HORAS=24

# De quanto em quanto tempo o servidor procura salas e arquivos para apagar.
LIMPEZA_MINUTOS=15

# ---------------------------------------------------------------------------
# Arquivos enviados no chat
# ---------------------------------------------------------------------------

# Depois de quantas horas um arquivo enviado no chat é apagado.
ARQUIVO_HORAS=24

# Teto por arquivo, em MB.
ARQUIVO_MAX_MB=25

# Teto de arquivos guardados por sala e no servidor inteiro, em MB.
ARQUIVO_SALA_MB=300
ARQUIVO_TOTAL_MB=3000

# Endereço público do site, usado para montar o link de convite. Em branco ele
# é deduzido do ANNOUNCED_IP e da porta. Preencha se você usar domínio:
# PUBLIC_URL=https://pinduccall.com.br

# Porta do WebSocket de sinalização (entrar na sala, chat, avisos).
PORT=4000

# Endereço que o servidor anuncia para os participantes se conectarem à mídia.
# Escolha conforme o seu cenário:
#   - Tailscale/ZeroTier: o IP da VPN, ex.: 100.101.102.103
#   - Port forwarding:    seu IP público fixo ou o hostname do DDNS
#   - Só LAN:             deixe em branco (ele detecta o IP local sozinho)
# ANNOUNCED_IP=

# Faixa de portas usada pela voz e pelo compartilhamento de tela.
# Precisa estar liberada no firewall do Windows (e no roteador, se usar port forwarding).
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100

# Quantas pessoas cabem em uma sala ao mesmo tempo.
MAX_PEERS=10

# Nome da sala padrão.
DEFAULT_ROOM=geral

# Teto de upload que o servidor aceita por pessoa, em bits por segundo.
# 6 Mbps por pessoa é confortável para 1080p30. Baixe se sua internet sofrer.
MAX_INCOMING_BITRATE=6000000

# Quantos processos de mídia subir. Em branco = um por núcleo (máx. 8).
# MEDIASOUP_WORKERS=

# Nível de log: debug | info | warn | error
LOG_LEVEL=info
MEDIASOUP_LOG_LEVEL=warn

# ---------------------------------------------------------------------------
# TLS (opcional). Só é necessário se você quiser wss:// direto, sem túnel.
# Com Cloudflare Tunnel ou VPN você NÃO precisa disto.
# ---------------------------------------------------------------------------
# TLS_CERT=C:\caminho\certificado.pem
# TLS_KEY=C:\caminho\chave.pem
